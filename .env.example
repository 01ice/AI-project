# ===== 数据库 =====
# 本地开发：留空即可，默认使用 PGlite（文件型 Postgres，数据存在 .data/pglite）
# 服务器部署：填腾讯云 PostgreSQL 或 Docker 里的 Postgres 连接串
# NUXT_DATABASE_URL=postgres://user:password@127.0.0.1:5432/zhanqiao

# ===== 站点 =====
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# ===== 邮件（QQ 邮箱 SMTP，D2 使用）=====
# 授权码在 QQ 邮箱「设置 → 账户 → 开启 POP3/SMTP 服务」中生成，不是登录密码
NUXT_SMTP_HOST=smtp.qq.com
NUXT_SMTP_PORT=465
NUXT_SMTP_USER=
NUXT_SMTP_PASS=

# ===== 内容审核（D5 使用）=====
NUXT_DEEPSEEK_API_KEY=
