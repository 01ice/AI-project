/* pages/movie/movie.wxss — 首页 */
.page {
  min-height: 100vh;
  background: #F5F5F5;
}

/* ===== 顶部：城市 + 搜索 ===== */
.topbar {
  display: flex;
  align-items: center;
  height: 92rpx;
  padding: 0 24rpx;
  background: #FFFFFF;
}
.city {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  padding-right: 18rpx;
}
.city-name {
  font-size: 32rpx;
  color: #222;
  font-weight: 500;
}
.city-arrow {
  font-size: 22rpx;
  color: #999;
  margin-left: 6rpx;
  line-height: 1;
}
.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  height: 68rpx;
  padding: 0 24rpx;
  background: #F2F3F5;
  border-radius: 34rpx;
}
.search-icon {
  font-size: 26rpx;
  margin-right: 12rpx;
  opacity: 0.55;
}
.search-ph {
  font-size: 28rpx;
  color: #A8A8A8;
}

/* ===== 轮播 ===== */
.banner {
  height: 440rpx;
  background: #FFFFFF;
}
.banner-item {
  position: relative;
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  transform: scale(0.93);
  transition: transform 0.3s ease;
}
.banner-item.is-active {
  transform: scale(1);
}
.banner-emoji {
  font-size: 130rpx;
  line-height: 1;
  transform: translateY(-56rpx);
}
.banner-shade {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 58%;
  background: linear-gradient(to bottom, rgba(0, 0, 0, 0), rgba(0, 0, 0, 0.55));
}
.banner-copy {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 24%;
  text-align: center;
}
.banner-t1 {
  display: block;
  font-size: 42rpx;
  font-weight: 800;
  color: #E8403A;
  letter-spacing: 4rpx;
  text-shadow: 0 0 8rpx #FFFFFF, 0 0 4rpx #FFFFFF, 0 2rpx 2rpx rgba(255, 255, 255, 0.9);
}
.banner-t2 {
  display: block;
  margin-top: 6rpx;
  font-size: 30rpx;
  font-weight: 800;
  color: #FFFFFF;
  letter-spacing: 2rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.55), 0 0 2rpx rgba(0, 0, 0, 0.6);
}

/* ===== 公告跑马灯 ===== */
.notice {
  display: flex;
  align-items: center;
  height: 84rpx;
  background: #FDEBEA;
  overflow: hidden;
}
.notice-icon {
  width: 74rpx;
  flex-shrink: 0;
  text-align: center;
  font-size: 28rpx;
  color: #E8403A;
}
.notice-track {
  flex: 1;
  height: 84rpx;
  overflow: hidden;
  position: relative;
}
.notice-marquee {
  display: flex;
  white-space: nowrap;
  animation: noticeScroll 18s linear infinite;
}
.notice-text {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #E8403A;
  line-height: 84rpx;
  padding-right: 80rpx;
}
@keyframes noticeScroll {
  from { transform: translateX(0); }
  to { transform: translateX(-50%); }
}

/* ===== Tab ===== */
.tabs {
  display: flex;
  justify-content: center;
  align-items: flex-end;
  background: #FFFFFF;
  padding: 22rpx 0 18rpx;
}
.tab {
  position: relative;
  margin: 0 48rpx;
  padding-bottom: 14rpx;
  font-size: 30rpx;
  color: #666666;
}
.tab-on {
  font-size: 34rpx;
  font-weight: 600;
  color: #E8403A;
}
.tab-line {
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 48rpx;
  height: 6rpx;
  margin-left: -24rpx;
  border-radius: 3rpx;
  background: #E8403A;
}

/* ===== 影片列表 ===== */
.list {
  padding: 20rpx 0 0;
}
.movie-card {
  position: relative;
  display: flex;
  margin: 0 24rpx 20rpx;
  padding: 24rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}
.poster-sm {
  flex-shrink: 0;
  width: 156rpx;
  height: 296rpx;
}
.poster-sm .poster-emoji {
  font-size: 68rpx;
}
.poster-sm .poster-name {
  font-size: 22rpx;
  line-height: 1.3;
  padding: 0 10rpx;
  bottom: 10rpx;
}

.info {
  flex: 1;
  min-width: 0;
  padding-left: 20rpx;
  padding-right: 118rpx;
}

.row-title {
  display: flex;
  align-items: center;
  flex-wrap: nowrap;
}
.score {
  font-size: 28rpx;
  font-weight: 700;
  color: #FF8A00;
  flex-shrink: 0;
}
.score-unit {
  font-size: 22rpx;
  color: #FF8A00;
  margin-right: 12rpx;
  flex-shrink: 0;
}
.title {
  font-size: 32rpx;
  font-weight: 600;
  color: #222222;
  flex-shrink: 0;
  max-width: 240rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  margin-right: 12rpx;
}
.row-title .tag {
  flex-shrink: 0;
}

.row-meta {
  display: flex;
  flex-wrap: wrap;
  margin-top: 14rpx;
}
.meta {
  font-size: 24rpx;
  color: #999999;
  margin-right: 14rpx;
  line-height: 1.5;
  flex-shrink: 0;
}

.row-credit {
  display: flex;
  align-items: baseline;
  margin-top: 8rpx;
  overflow: hidden;
  white-space: nowrap;
}
.k {
  font-size: 24rpx;
  color: #999999;
  flex-shrink: 0;
}
.v {
  font-size: 24rpx;
  color: #333333;
  margin-left: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex-shrink: 1;
}
.sep {
  font-size: 22rpx;
  color: #DDDDDD;
  margin: 0 14rpx;
  flex-shrink: 0;
}

.row-desc {
  margin-top: 12rpx;
  font-size: 25rpx;
  color: #666666;
  line-height: 1.55;
  overflow: hidden;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
}
.row-want {
  margin-top: 14rpx;
  font-size: 25rpx;
  color: #FF8A00;
}

/* 购票按钮（右侧浮出） */
.buy {
  position: absolute;
  right: 24rpx;
  top: 54%;
  transform: translateY(-50%);
  width: 132rpx;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #FFFFFF;
  background: linear-gradient(135deg, #FF9440 0%, #FF7A33 100%);
  box-shadow: 0 6rpx 14rpx rgba(255, 122, 51, 0.3);
}
.buy:active {
  opacity: 0.86;
}

.page-bottom {
  height: 20rpx;
}
