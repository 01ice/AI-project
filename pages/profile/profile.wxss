/* pages/profile/profile.wxss — 个人中心 */
.page {
  min-height: 100vh;
  background: #F5F5F5;
  padding-bottom: 40rpx;
}

/* 红色渐变头图 */
.header {
  position: relative;
  height: 180rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #F2675C 0%, #E23A2F 58%, #D62C23 100%);
}
.header::after {
  content: '';
  position: absolute;
  right: -140rpx;
  top: -190rpx;
  width: 440rpx;
  height: 440rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.07);
}

/* 用户卡片 */
.user-card {
  position: relative;
  display: flex;
  align-items: center;
  margin: -20rpx 24rpx 20rpx;
  padding: 34rpx 30rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 18rpx rgba(0, 0, 0, 0.08);
}
.avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: #E9E9E9;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.avatar-icon {
  font-size: 74rpx;
  line-height: 1;
  opacity: 0.55;
}
.user-main {
  flex: 1;
  min-width: 0;
  padding-left: 26rpx;
}
.user-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #222222;
  line-height: 1.3;
}
.user-tag {
  display: inline-block;
  margin-top: 14rpx;
  padding: 2rpx 14rpx;
  font-size: 22rpx;
  color: #E8403A;
  background: #FDEBEA;
  border: 1rpx solid #F8CFCC;
  border-radius: 8rpx;
  line-height: 1.6;
}
.user-tip {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #999999;
}
.arrow {
  font-size: 44rpx;
  color: #CCCCCC;
  line-height: 1;
  padding-left: 12rpx;
}

/* 订单 / 功能 卡片 */
.order-card {
  padding-bottom: 16rpx;
}

/* 四宫格 */
.grid {
  display: flex;
  margin-top: 34rpx;
}
.grid-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.circle {
  position: relative;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.circle-icon {
  font-size: 44rpx;
  line-height: 1;
}
.badge {
  position: absolute;
  top: -4rpx;
  right: -4rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: 16rpx;
  background: #E8403A;
  color: #FFFFFF;
  font-size: 20rpx;
  line-height: 32rpx;
  text-align: center;
  box-sizing: border-box;
}
.grid-label {
  margin-top: 18rpx;
  font-size: 26rpx;
  color: #666666;
}

/* 退出登录 */
.logout,
.login {
  margin: 30rpx 24rpx 0;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  font-size: 30rpx;
  color: #E8403A;
  background: #FFFFFF;
  border-radius: 16rpx;
}
.logout:active,
.login:active {
  background: #FAFAFA;
}
.login {
  color: #FFFFFF;
  background: linear-gradient(135deg, #FF9440 0%, #FF7A33 100%);
}

.page-bottom {
  height: 40rpx;
}
