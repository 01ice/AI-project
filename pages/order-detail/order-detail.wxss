/* pages/order-detail/order-detail.wxss — 订单详情 */
.page {
  min-height: 100vh;
  background: #F5F5F5;
  padding-top: 20rpx;
}

/* 状态头 */
.status-card {
  display: flex;
  align-items: center;
  margin: 0 24rpx 20rpx;
  padding: 40rpx 34rpx;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.08);
}
.st-left {
  flex: 1;
  min-width: 0;
}
.st-text {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1.3;
}
.st-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.88);
  line-height: 1.5;
}
.st-count {
  display: block;
  margin-top: 8rpx;
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.8);
}
.st-icon {
  flex-shrink: 0;
  font-size: 76rpx;
  margin-left: 20rpx;
  opacity: 0.9;
}

/* 取票码 */
.code-card {
  text-align: center;
  padding: 36rpx 28rpx;
}
.code-label {
  font-size: 25rpx;
  color: #999999;
}
.code-value {
  margin-top: 16rpx;
  font-size: 52rpx;
  font-weight: 700;
  color: #E8403A;
  letter-spacing: 6rpx;
  font-family: 'Courier New', Courier, monospace;
}
.code-tip {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #AAAAAA;
}

/* 影片行 */
.movie-row {
  display: flex;
  align-items: center;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #F2F2F2;
}
.poster-mid {
  width: 120rpx;
  height: 168rpx;
  flex-shrink: 0;
}
.poster-mid .poster-emoji {
  font-size: 54rpx;
  transform: none;
}
.movie-info {
  flex: 1;
  min-width: 0;
  padding-left: 22rpx;
}
.movie-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #222222;
}
.movie-meta {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #888888;
  line-height: 1.5;
}

/* 信息行 */
.info-line {
  display: flex;
  align-items: flex-start;
  margin-top: 18rpx;
}
.info-line .k {
  flex-shrink: 0;
  width: 110rpx;
  font-size: 25rpx;
  color: #999999;
  line-height: 1.6;
}
.info-line .v {
  flex: 1;
  font-size: 25rpx;
  color: #444444;
  line-height: 1.6;
}
.seat-text {
  color: #E8403A;
  font-weight: 500;
}
.copy {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 0 18rpx;
  font-size: 22rpx;
  color: #E8403A;
  border: 1rpx solid #E8403A;
  border-radius: 22rpx;
  line-height: 1.8;
}

/* 价格明细 */
.fee-line {
  display: flex;
  align-items: center;
  margin-top: 22rpx;
}
.fee-k {
  flex: 1;
  font-size: 26rpx;
  color: #666666;
}
.fee-v {
  font-size: 26rpx;
  color: #333333;
}
.fee-total {
  margin-top: 26rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid #F2F2F2;
}
.fee-total .fee-k {
  font-size: 28rpx;
  font-weight: 600;
  color: #222222;
}
.fee-total-v {
  font-size: 38rpx;
  font-weight: 700;
  color: #E8403A;
}
.fee-total-v .sym {
  font-size: 24rpx;
}

/* 底部 */
.bar-space {
  height: 160rpx;
}
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 30;
  background: #FFFFFF;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}
.bb-row {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding: 16rpx 24rpx;
}
.bb-btn {
  margin-left: 20rpx;
  padding: 0 44rpx;
  height: 80rpx;
  line-height: 78rpx;
  font-size: 28rpx;
  color: #666666;
  border: 1rpx solid #DDDDDD;
  border-radius: 40rpx;
  box-sizing: border-box;
}
.bb-btn-primary {
  color: #FFFFFF;
  background: linear-gradient(135deg, #FF9440 0%, #FF7A33 100%);
  border-color: transparent;
  box-shadow: 0 6rpx 16rpx rgba(255, 122, 51, 0.3);
}
.bb-btn:active {
  opacity: 0.85;
}
