/* app.wxss — 全局样式
   说明：微信小程序 WXSS 不支持 CSS 变量(var)，此处统一使用字面量颜色值。
   主色：#E8403A（品牌红） 强调色：#FF7A33（购票橙） 标签橙：#FF8A00
*/
page {
  background: #F5F5F5;
  color: #333;
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC', 'Microsoft YaHei', sans-serif;
  -webkit-font-smoothing: antialiased;
}

/* ---------- 通用卡片 ---------- */
.mt-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  margin: 0 24rpx 20rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}

/* ---------- 区块标题（左侧红条） ---------- */
.sec-title {
  display: flex;
  align-items: center;
}
.sec-bar {
  width: 8rpx;
  height: 32rpx;
  border-radius: 4rpx;
  background: #E8403A;
  margin-right: 14rpx;
}
.sec-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #222;
}
.sec-more {
  margin-left: auto;
  font-size: 26rpx;
  color: #999;
}

/* ---------- 标签（格式：IMAX 2D / CINITY 3D） ---------- */
.tag {
  display: inline-block;
  padding: 0 8rpx;
  height: 34rpx;
  line-height: 32rpx;
  font-size: 20rpx;
  border-radius: 6rpx;
  border: 1rpx solid #C8C8C8;
  color: #999;
  box-sizing: border-box;
}
.tag-orange {
  border-color: #FF8A00;
  color: #FF8A00;
}
.tag-red {
  border-color: #E8403A;
  color: #E8403A;
}
.tag-purple {
  border-color: #7B5CF0;
  color: #7B5CF0;
}

/* ---------- 价格 ---------- */
.mt-price {
  color: #E8403A;
  font-weight: 600;
}
.mt-price .sym {
  font-size: 22rpx;
}
.mt-price .num {
  font-size: 34rpx;
}
.mt-price .unit {
  font-size: 22rpx;
  font-weight: 400;
}

/* ---------- 按钮 ---------- */
.mt-btn {
  border-radius: 40rpx;
  font-size: 28rpx;
  text-align: center;
  border: none;
  line-height: 2.4;
  padding: 0 30rpx;
}
.mt-btn::after {
  border: none;
}
.mt-btn-primary {
  background: linear-gradient(135deg, #FF9440 0%, #FF7A33 100%);
  color: #FFFFFF;
  box-shadow: 0 6rpx 14rpx rgba(255, 122, 51, 0.28);
}
.mt-btn-danger {
  background: #E8403A;
  color: #FFFFFF;
}
.mt-btn-plain {
  background: #FFFFFF;
  color: #666;
  border: 1rpx solid #DDD;
}

/* ---------- 分割线 ---------- */
.mt-hairline {
  height: 1rpx;
  background: #F0F0F0;
}

/* ---------- 底部安全区 ---------- */
.safe-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}
.safe-fix {
  height: constant(safe-area-inset-bottom);
  height: env(safe-area-inset-bottom);
}

/* ---------- 空态 ---------- */
.mt-empty {
  text-align: center;
  padding: 140rpx 40rpx;
  color: #999;
}
.mt-empty .icon {
  font-size: 90rpx;
  display: block;
  margin-bottom: 20rpx;
}
.mt-empty .tip {
  font-size: 28rpx;
  display: block;
  line-height: 1.7;
}

/* ---------- 电影海报占位（emoji + 渐变） ---------- */
.poster {
  position: relative;
  overflow: hidden;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.poster-img {
  width: 100%;
  height: 100%;
  display: block;
}
.poster-emoji {
  font-size: 56rpx;
  line-height: 1;
  transform: translateY(-8rpx);
}
.poster-shade {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 50%;
  background: linear-gradient(to bottom, rgba(0, 0, 0, 0), rgba(0, 0, 0, 0.62));
}
.poster-name {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 6rpx;
  padding: 0 8rpx;
  font-size: 20rpx;
  line-height: 1.25;
  color: #FFFFFF;
  text-align: center;
  font-weight: 600;
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.5);
}
