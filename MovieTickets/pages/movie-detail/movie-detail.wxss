/* pages/movie-detail/movie-detail.wxss — 影片详情 */
.page {
  min-height: 100vh;
  background: #F5F5F5;
  padding-top: 20rpx;
}

/* ===== 头部 ===== */
.hero {
  position: relative;
  overflow: hidden;
  padding: 40rpx 30rpx 44rpx;
  margin-bottom: 20rpx;
}
.hero-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}
.hero-mask {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.62);
}
.hero-inner {
  position: relative;
  display: flex;
}
.poster-lg {
  flex-shrink: 0;
  width: 220rpx;
  height: 320rpx;
  border-radius: 12rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.35);
}
.poster-lg .poster-emoji {
  font-size: 96rpx;
}
.poster-lg .poster-name {
  font-size: 24rpx;
  bottom: 12rpx;
}

.hero-info {
  flex: 1;
  min-width: 0;
  padding-left: 26rpx;
  color: #FFFFFF;
}
.h-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1.3;
}
.h-score-line {
  display: flex;
  align-items: baseline;
  margin-top: 16rpx;
}
.h-score {
  font-size: 40rpx;
  font-weight: 700;
  color: #FFB44D;
}
.h-score-unit {
  font-size: 24rpx;
  color: #FFB44D;
  margin-left: 4rpx;
}
.h-score-tip {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-left: 14rpx;
}
.h-want {
  font-size: 28rpx;
  color: #FFB44D;
  font-weight: 600;
}
.h-meta {
  margin-top: 10rpx;
  font-size: 25rpx;
  color: rgba(255, 255, 255, 0.78);
  line-height: 1.5;
}
.h-tags {
  margin-top: 18rpx;
}
.tag-light {
  border-color: rgba(255, 255, 255, 0.7) !important;
  color: #FFFFFF !important;
}

/* ===== 简介 ===== */
.desc {
  margin-top: 22rpx;
  font-size: 27rpx;
  color: #444444;
  line-height: 1.75;
  overflow: hidden;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
}
.desc-open {
  display: block;
  -webkit-line-clamp: 99;
}
.desc-toggle {
  margin-top: 14rpx;
  font-size: 25rpx;
  color: #E8403A;
  text-align: center;
}

/* ===== 演职人员 ===== */
.cast-scroll {
  margin-top: 26rpx;
  white-space: nowrap;
}
.cast-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  width: 140rpx;
  margin-right: 12rpx;
  vertical-align: top;
}
.cast-avatar {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.cast-emoji {
  font-size: 52rpx;
  line-height: 1;
}
.cast-name {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #333333;
  text-align: center;
  width: 100%;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.cast-role {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #AAAAAA;
}

/* ===== 剧照 ===== */
.stills {
  display: flex;
  flex-wrap: wrap;
  margin-top: 24rpx;
}
.still {
  width: calc(33.33% - 12rpx);
  height: 150rpx;
  margin: 0 18rpx 18rpx 0;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.still:nth-child(3n) {
  margin-right: 0;
}
.still-emoji {
  font-size: 60rpx;
}

/* ===== 须知 ===== */
.tips {
  margin-top: 20rpx;
}
.tip-row {
  display: flex;
  margin-bottom: 12rpx;
}
.tip-dot {
  color: #E8403A;
  font-size: 28rpx;
  margin-right: 10rpx;
  line-height: 1.6;
}
.tip-text {
  flex: 1;
  font-size: 25rpx;
  color: #777777;
  line-height: 1.6;
}

/* ===== 底部操作条 ===== */
.bar-space {
  height: 140rpx;
}
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 30;
  background: #FFFFFF;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}
.bb-row {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
}
.bb-want {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 120rpx;
  flex-shrink: 0;
}
.bb-heart {
  font-size: 34rpx;
  color: #E8403A;
  line-height: 1;
}
.bb-want-text {
  font-size: 20rpx;
  color: #888888;
  margin-top: 6rpx;
}
.bb-buy {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: 42rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
  background: linear-gradient(135deg, #FF9440 0%, #FF7A33 100%);
  box-shadow: 0 6rpx 16rpx rgba(255, 122, 51, 0.3);
}
.bb-disabled {
  background: #CCCCCC;
  box-shadow: none;
}
