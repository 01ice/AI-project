/* pages/orders/orders.wxss — 我的订单 */
.page {
  min-height: 100vh;
  background: #F5F5F5;
}

/* 状态筛选 */
.tab-scroll {
  position: sticky;
  top: 0;
  z-index: 20;
  background: #FFFFFF;
  white-space: nowrap;
}
.tab-list {
  display: flex;
  padding: 0 12rpx;
}
.tab-item {
  position: relative;
  flex-shrink: 0;
  padding: 26rpx 26rpx 22rpx;
  font-size: 28rpx;
  color: #666666;
}
.tab-item.tab-on {
  color: #E8403A;
  font-weight: 600;
}
.tab-line {
  position: absolute;
  left: 50%;
  bottom: 8rpx;
  width: 44rpx;
  height: 6rpx;
  margin-left: -22rpx;
  border-radius: 3rpx;
  background: #E8403A;
}

/* 订单卡片 */
.list {
  padding: 20rpx 0 0;
}
.order-card {
  margin: 0 24rpx 20rpx;
  padding: 26rpx 24rpx 20rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}
.oc-head {
  display: flex;
  align-items: center;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #F5F5F5;
}
.oc-status {
  font-size: 27rpx;
  font-weight: 600;
}
.oc-no {
  margin-left: auto;
  font-size: 22rpx;
  color: #BBBBBB;
}
.oc-body {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
}
.poster-mini {
  width: 110rpx;
  height: 150rpx;
  flex-shrink: 0;
}
.poster-mini .poster-emoji {
  font-size: 52rpx;
  transform: none;
}
.oc-info {
  flex: 1;
  min-width: 0;
  padding-left: 20rpx;
}
.oc-title {
  font-size: 31rpx;
  font-weight: 600;
  color: #222222;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.oc-line {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #888888;
  line-height: 1.45;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.oc-seat {
  color: #E8403A;
}
.oc-arrow {
  flex-shrink: 0;
  font-size: 40rpx;
  color: #CCCCCC;
  line-height: 1;
  padding-left: 10rpx;
}
.oc-foot {
  display: flex;
  align-items: baseline;
  padding-top: 18rpx;
  border-top: 1rpx solid #F5F5F5;
}
.oc-count {
  font-size: 24rpx;
  color: #999999;
}
.oc-total {
  margin-left: auto;
  font-size: 24rpx;
  color: #666666;
}
.oc-price {
  font-size: 34rpx;
  font-weight: 700;
  color: #E8403A;
}
.oc-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 20rpx;
}
.oc-btn {
  margin-left: 18rpx;
  padding: 0 30rpx;
  height: 62rpx;
  line-height: 60rpx;
  font-size: 26rpx;
  color: #666666;
  border: 1rpx solid #DDDDDD;
  border-radius: 32rpx;
  box-sizing: border-box;
}
.oc-btn-primary {
  color: #FFFFFF;
  background: linear-gradient(135deg, #FF9440 0%, #FF7A33 100%);
  border-color: transparent;
}
.oc-btn:active {
  opacity: 0.85;
}

/* 空态按钮 */
.empty-btn {
  display: inline-block;
  margin-top: 34rpx;
  padding: 0 52rpx;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 28rpx;
  color: #FFFFFF;
  background: linear-gradient(135deg, #FF9440 0%, #FF7A33 100%);
  border-radius: 38rpx;
}

.page-bottom {
  height: 40rpx;
}
