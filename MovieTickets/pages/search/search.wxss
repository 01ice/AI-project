/* pages/search/search.wxss — 搜索 */
.page {
  min-height: 100vh;
  background: #F5F5F5;
}

.search-bar {
  position: sticky;
  top: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  padding: 18rpx 24rpx;
  background: #FFFFFF;
}
.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  height: 72rpx;
  padding: 0 24rpx;
  background: #F2F3F5;
  border-radius: 36rpx;
}
.search-icon {
  font-size: 26rpx;
  margin-right: 12rpx;
  opacity: 0.55;
}
.search-input {
  flex: 1;
  font-size: 28rpx;
  height: 72rpx;
}
.ph {
  color: #A8A8A8;
}
.clear {
  font-size: 24rpx;
  color: #AAAAAA;
  padding: 8rpx 4rpx 8rpx 16rpx;
}
.cancel {
  flex-shrink: 0;
  margin-left: 24rpx;
  font-size: 28rpx;
  color: #666666;
}

/* 分组 */
.group {
  margin: 20rpx 24rpx 0;
  padding: 24rpx 24rpx 8rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
}
.group-title {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 20rpx;
}
.clear-history {
  margin-left: auto;
  font-size: 23rpx;
  color: #AAAAAA;
  font-weight: 400;
}
.chip-wrap {
  display: flex;
  flex-wrap: wrap;
}
.chip {
  padding: 10rpx 26rpx;
  margin: 0 18rpx 18rpx 0;
  background: #F5F6F8;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #555555;
}
.chip:active {
  background: #FDEBEA;
  color: #E8403A;
}

/* 结果 */
.result-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}
.result-item:last-child {
  border-bottom: none;
}
.poster-tiny {
  width: 86rpx;
  height: 118rpx;
  flex-shrink: 0;
}
.poster-tiny .poster-emoji {
  font-size: 40rpx;
  transform: none;
}
.ci-icon {
  width: 86rpx;
  height: 86rpx;
  border-radius: 12rpx;
  background: #F5F6F8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  flex-shrink: 0;
}
.ri-info {
  flex: 1;
  min-width: 0;
  padding-left: 20rpx;
}
.ri-title {
  font-size: 29rpx;
  font-weight: 600;
  color: #222222;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.ri-meta {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #999999;
  line-height: 1.4;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.ri-price {
  color: #E8403A;
}
.ri-arrow {
  flex-shrink: 0;
  font-size: 40rpx;
  color: #CCCCCC;
  line-height: 1;
  padding-left: 12rpx;
}
