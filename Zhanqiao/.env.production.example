# ============================================================
# 服务器环境变量模板
# 用法：复制成 .env 放在服务器项目根目录，docker compose 会读取它
# 注意：数据库密码请换成自己的强密码
# ============================================================

# ===== 数据库（docker-compose 使用）=====
POSTGRES_USER=zhanqiao
# 建议用 16 位以上的字母数字组合：这个密码会被拼进数据库连接串，
# 含有 @ : / ? # 等字符时需要额外转义，用字母数字最省事
POSTGRES_PASSWORD=请改成字母数字组成的强密码
POSTGRES_DB=zhanqiao

# 应用侧连接串由 docker-compose 自动拼好，这里不用填
# NUXT_DATABASE_URL=postgres://用户:密码@db:5432/zhanqiao

# ===== 站点地址 =====
# 备案前：http://服务器公网IP:8080
# 备案后换成：https://你的域名（Cookie 会自动带上 Secure）
NUXT_PUBLIC_SITE_URL=http://服务器公网IP:8080

# ===== 域名与 HTTPS（备案通过后再填）=====
# 1) 域名解析到服务器 IP，安全组放行 80 / 443
# 2) 填好下面两项后执行：sudo docker compose --profile https up -d
# 3) 同时把 NUXT_PUBLIC_SITE_URL 改成 https://你的域名，并打开 NUXT_TRUST_PROXY
# SITE_DOMAIN=example.com
# ACME_EMAIL=你的邮箱（用于证书到期通知）
#
# NUXT_TRUST_PROXY=1   # 只有放在反向代理后面时才打开，否则 X-Forwarded-For 可被伪造绕过限流

# ===== 邮件（QQ 邮箱 SMTP）=====
NUXT_SMTP_HOST=smtp.qq.com
NUXT_SMTP_PORT=465
NUXT_SMTP_USER=你的邮箱
NUXT_SMTP_PASS=你的16位授权码

# ===== 内容审核（可选）=====
NUXT_DEEPSEEK_API_KEY=

# ===== 图片存储（可选，配好后自动改用 COS）=====
# 服务器带宽只有 4Mbps，正式使用建议把图片放到 COS：
# 1) 腾讯云控制台创建存储桶（地域选北京，权限「公有读私有写」）
# 2) 访问管理 → API 密钥管理 → 新建子账号密钥，只授予该桶读写权限
# 3) 填好下面四项并重启应用，上传的图片会直接进 COS，不再占用服务器带宽
# 「公有读私有写」本身不收费，计费的是外网下行流量；建议同时开启防盗链
# NUXT_COS_SECRET_ID=
# NUXT_COS_SECRET_KEY=
# NUXT_COS_BUCKET=zhanqiao-1250000000
# NUXT_COS_REGION=ap-beijing
# NUXT_COS_PUBLIC_BASE_URL=   # 可选：绑定 CDN 或自定义域名时填
