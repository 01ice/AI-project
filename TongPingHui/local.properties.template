# ===========================================================================
# 复制本文件为 local.properties（与 settings.gradle.kts 同级），再填上真实值。
# local.properties 已被 .gitignore 忽略，不要把密钥提交到 Git。
# ===========================================================================

# Android SDK 路径（Android Studio 一般会自动生成这一行，注意反斜杠要转义）
sdk.dir=D\:\\Android\\Sdk

# ---------------------------------------------------------------------------
# 腾讯云 TRTC —— 控制台 https://console.cloud.tencent.com/trtc
# 应用名称：多人会议app
# ---------------------------------------------------------------------------
TRTC_SDK_APP_ID=1600162594
# ⚠️ SDKSecretKey 需要在控制台「应用管理 → 开发辅助」里生成后再填到这里。
#    它只用于本地调试生成 UserSig；正式环境必须由后端生成（见 server/src/utils/userSig.js）。
TRTC_SDK_SECRET_KEY=
# UserSig 有效期（秒），默认 7 天
TRTC_USER_SIG_EXPIRE=604800

# ---------------------------------------------------------------------------
# 后端地址
#   真机调试填电脑的局域网 IP，例如 http://192.168.1.10:8080/
#   模拟器访问宿主机用 http://10.0.2.2:8080/
# ---------------------------------------------------------------------------
API_BASE_URL=http://192.168.1.100:8080/

# ---------------------------------------------------------------------------
# 正式包签名（内部打包 APK 用，可选；不填则 release 用 debug 签名）
# ---------------------------------------------------------------------------
RELEASE_STORE_FILE=
RELEASE_STORE_PASSWORD=
RELEASE_KEY_ALIAS=
RELEASE_KEY_PASSWORD=
