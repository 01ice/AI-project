<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ================= 基础网络 ================= -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />

    <!-- ================= 音视频 ================= -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- ================= 屏幕共享（MediaProjection + 前台服务）================= -->
    <!-- 前台服务本体 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- ⚠️ Android 14 (API 34) 起必须声明，且前台服务要显式指定 mediaProjection 类型 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- Android 13+ 前台服务通知要用户授权，否则通知不显示 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 屏幕共享时的悬浮小窗（TUIRoomKit 内部也要求这个权限） -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- ================= 其它 ================= -->
    <!-- 读取相册换头像（Android 13+ 用细分权限，低版本用 READ_EXTERNAL_STORAGE）-->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.TongPingHui"
        android:usesCleartextTraffic="true"
        tools:replace="android:allowBackup">

        <!-- 主界面：登录 / 会议列表 / 个人中心（Compose 单 Activity） -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 会议房间：承载 TUIRoomKit 的 RoomMainView -->
        <activity
            android:name=".ui.room.MeetingRoomActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="false"
            android:launchMode="singleTop"
            android:theme="@style/Theme.TongPingHui.FullScreen" />

        <!-- 屏幕共享前台服务 -->
        <!-- targetSdk 34 时 foregroundServiceType 必须显式写 mediaProjection -->
        <service
            android:name=".service.ScreenShareService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

    </application>

</manifest>
