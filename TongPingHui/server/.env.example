# 复制为 .env 后按需修改
PORT=8080

# JWT 签名密钥（务必改成随机长字符串）
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# 腾讯云 TRTC（控制台 → 应用管理；SDKSecretKey 在「开发辅助」里生成）
TRTC_SDK_APP_ID=1600162594
TRTC_SDK_SECRET_KEY=f4d6b9cde663ffdbcb82312037f93204244642349f2cee1b4ff17c329fd106f1
# UserSig 有效期（秒），默认 7 天
TRTC_USER_SIG_EXPIRE=604800

# 数据文件（本地 JSON 存储，生产建议换 MySQL/PostgreSQL/Firebase Firestore）
DATA_FILE=./data/db.json
