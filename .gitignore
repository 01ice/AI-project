# ===== 通用忽略（适用于所有子项目）=====

# 依赖
node_modules/
venv/
.venv/
__pycache__/
*.pyc

# 构建产物
.nuxt/
.output/
dist/
build/
*.min.js
*.min.css

# 日志
*.log

# 编辑器与系统
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# 微信开发者工具私有配置
project.private.config.json

# 开发期产物（截图、渲染预览、测试报告）
tools/shot-*.png
tools/preview*.html
tools/*-report.txt

# ===== 本工作区专属 =====

# 开发者工具 UserData 备份（体积大，与项目无关）
.backup-*/

# 本地工作区元数据
.workbuddy/
.wbapp_*.genie

# 一次性整理脚本
.restructure.py
.cleanup.py

# 预览站点与工作区工具（本地辅助，不随项目发布）
preview-site/
/tools/

# 结构整理残留
MovieTickets/MovieTickets/

# 暂未纳入本仓库的其他项目
LocalLifestyleServices/

# ===== Zhanqiao/（栈桥）专属 =====

# 本地数据库（PGlite 数据目录）
.data/

# 本地上传的图片（部署时会改由 COS 托管）
public/uploads/

# 环境变量（含密钥，禁止提交）
.env
.env.*
!.env.example
!.env.production.example
